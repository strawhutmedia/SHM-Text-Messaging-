# ── Bridge server ────────────────────────────────────────────────
# Port the middleware listens on
PORT=3000

# Public HTTPS URL of this middleware (your Cloudflare Tunnel / ngrok URL).
# GHL and BlueBubbles both deliver webhooks here.
PUBLIC_URL=https://your-tunnel-url.example.com

# Shared secret appended to webhook URLs so random internet traffic
# can't inject messages. Pick any long random string.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# ── BlueBubbles (runs on your Mac) ───────────────────────────────
# URL of the BlueBubbles server. If this middleware runs on the same
# Mac, http://localhost:1234 works.
BLUEBUBBLES_URL=http://localhost:1234
# The server password you set in the BlueBubbles app
BLUEBUBBLES_PASSWORD=your-bluebubbles-password

# ── GoHighLevel marketplace app ──────────────────────────────────
# From your app at https://marketplace.gohighlevel.com (Developer mode)
GHL_CLIENT_ID=your-app-client-id
GHL_CLIENT_SECRET=your-app-client-secret

# Conversation Provider ID — created in your marketplace app under
# "Conversation Provider". This is what routes GHL SMS sends to us.
GHL_CONVERSATION_PROVIDER_ID=your-conversation-provider-id

# Where OAuth tokens are stored on disk
TOKEN_STORE_PATH=./data/tokens.json
